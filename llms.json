    {
      "type": "COLUMNS_SET",
      "doc": "Set all available columns.",
      "payload": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    {
      "type": "COLUMN_ORDER_SET",
      "doc": "Set column order: ['column_name_1', 'column_name_2']",
      "payload": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    {
      "type": "COLUMN_STICK_SET",
      "doc": "Pin (stick) column on left or right side.",
      "payload": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string"
          },
          "position": {
            "type": [
              "string",
              "boolean"
            ],
            "enum": [
              "left",
              "right",
              false
            ]
          }
        },
        "required": [
          "column",
          "position"
        ],
        "additionalProperties": false
      }
    },
    {
